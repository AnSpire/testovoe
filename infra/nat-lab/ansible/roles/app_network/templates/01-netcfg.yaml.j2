network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: false
      optional: true
      # Эта карта остаётся только для управления (Vagrant SSH) — она не
      # должна становиться маршрутом по умолчанию для интернета.
      dhcp4-overrides:
        use-routes: false
      nameservers:
        addresses: [8.8.8.8, 1.1.1.1]
    eth1:
      dhcp4: false
      addresses: [192.168.56.10/24]
      nameservers:
        addresses: [8.8.8.8, 1.1.1.1]
      routes:
        - to: default
          via: 192.168.56.1
